                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('role is employee', function () {",
                  "  pm.expect(body.role).to.eql('employee');",
                  "});",
                  "pm.collectionVariables.set('employeeToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
