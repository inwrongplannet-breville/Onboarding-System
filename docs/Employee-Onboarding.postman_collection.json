          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      }
    },
    {
      "name": "Tick after archive - 409 (the archive condition on the write)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "// This is the one that matters. Without it a cancelled record could be",
              "// ticked to 8 of 8 and left stamped 'Onboarding Cancelled', with nothing",
              "// in the table to say which of the two claims was the lie."
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}/checklist/id-proof",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}",
            "checklist",
            "id-proof"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"done\": true\n}"
        }
      }
    },
    {
      "name": "Update after archive - 409 (proves the record is frozen)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('says why', () =>",
              "  pm.expect(pm.response.json().error.message).to.include('archived'));",
              "// Two guards behind this: a check before the write for the message, and",
              "// attribute_not_exists(archivedAs) on the write itself for the race."
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ghost\",\n  \"lastName\": \"Record\",\n  \"email\": \"ghost@breville.com\",\n  \"department\": \"HR\",\n  \"jobTitle\": \"Should not exist\",\n  \"startDate\": \"2026-09-01\",\n  \"employmentType\": \"Intern\"\n}"
        }
      }
    },
    {
      "name": "Employee role - read-only",
      "description": "Signs in as the employee account and shows both halves of the role split: a trimmed read and a refused write. Run in order.",
      "item": [
