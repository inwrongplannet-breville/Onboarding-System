{
  "info": {
    "name": "Employee Onboarding - Phase 4 (two roles)",
    "description": "CRUD backend on AWS. Set the collection variable `baseUrl` to the ApiBaseUrl stack output. Run the folder top to bottom: Create mints a fresh employee number into `runEmployeeId`, captures the created id into `employeeId`, and every later request reuses it. The employee number is the DynamoDB partition key, so a rerun cannot reuse the last run's number.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://4w9q4450be.execute-api.eu-north-1.amazonaws.com/dev"
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "runEmail",
      "value": ""
    },
    {
      "key": "runEmployeeId",
      "value": ""
    },
    {
      "key": "lowerEmployeeId",
      "value": ""
    },
    {
      "key": "username",
      "value": "hr.admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "onboard-2026",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "employeeToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Sign in - run this first (stores {{token}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('role is official', function () {",
              "  pm.expect(body.role).to.eql('official');",
              "});",
              "// Every other request in this collection inherits it as bearer auth.",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Exchanges the demo officials credentials for a signed JWT and stores it as {{token}}. Every request below inherits it as bearer auth, so this one has to run first - on its own, or as the first request of a collection run.\n\nA 403 here means the deployed stack predates the login route. A 401 means the stack is not using the demo accounts; change {{username}} and {{password}}."
      }
    },
    {
      "name": "Create employee",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The employee number is the partition key, so a rerun would 409 on the number",
              "// the last run took. Mint a fresh one, inside the 20-character limit.",
              "pm.collectionVariables.set('runEmployeeId', 'PM' + String(Date.now()).slice(-8));",
              "// Work emails are not unique, but a fresh address keeps the run readable.",
              "pm.collectionVariables.set('runEmail', 'postman.run+' + Date.now() + '@breville.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('the id is the employee number we sent', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('runEmployeeId')));",
              "pm.test('starts with 8 unticked checklist items', () => {",
              "  pm.expect(body.checklist).to.have.lengthOf(8);",
              "  pm.expect(body.checklist.every(i => i.done === false)).to.be.true;",
              "});",
              "pm.test('starts Pending', () => pm.expect(body.status).to.eql('Pending'));",
              "pm.collectionVariables.set('employeeId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"{{runEmployeeId}}\",\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"{{runEmail}}\",\n  \"phone\": \"+61 412 883 016\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Software Engineer\",\n  \"manager\": \"Santosh Kumar\",\n  \"startDate\": \"2026-07-06\",\n  \"employmentType\": \"Full-time\"\n}"
        }
      }
    },
    {
      "name": "List employees",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const found = body.employees.find(e => e.id === pm.collectionVariables.get('employeeId'));",
              "pm.test('the new employee is in the list', () => pm.expect(found).to.exist);",
              "pm.test('list items carry their checklist', () => pm.expect(found.checklist).to.have.lengthOf(8));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        }
      }
    },
    {
      "name": "Get employee by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('matches the Phase 1 frontend model', () => {",
              "  ['id','firstName','lastName','email','phone','department','jobTitle','manager','startDate','employmentType','checklist']",
              "    .forEach(k => pm.expect(body).to.have.property(k));",
              "});",
              "pm.test('leaks no internal attributes', () => {",
              "  ['employeeKey','PK','SK','employeeId','entityType'].forEach(k => pm.expect(body).to.not.have.property(k));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}"
          ]
        }
      }
    },
    {
      "name": "Tick a checklist item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const offer = body.checklist.find(i => i.id === 'offer-letter');",
              "pm.test('the ticked item is done', () => pm.expect(offer.done).to.be.true);",
              "pm.test('the other seven are untouched', () => {",
              "  pm.expect(body.checklist.filter(i => i.done)).to.have.lengthOf(1);",
              "});",
              "pm.test('status is now derived as In Progress', () => pm.expect(body.status).to.eql('In Progress'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}/checklist/offer-letter",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees",
            "{{employeeId}}",
            "checklist",
            "offer-letter"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"done\": true }"
        }
      }
    },
    {
      "name": "Comment on a checklist item (tick untouched)",
