                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "var employees = pm.response.json().employees;",
                  "pm.test('there is something to check', function () {",
                  "  pm.expect(employees.length).to.be.above(0);",
                  "});",
                  "// Absent, not blank. See restrict_for_employee in common/models.py.",
                  "['email', 'phone', 'manager', 'employmentType', 'checklist',",
                  " 'archived', 'archivedAs', 'archivedAt'].forEach(function (field) {",
                  "  pm.test('does not send ' + field, function () {",
                  "    employees.forEach(function (employee) {",
