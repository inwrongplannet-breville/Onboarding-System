              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const item = pm.response.json().checklist.find(i => i.id === 'bank-details');",
              "pm.test('the comment is stored', () => pm.expect(item.comment).to.eql('Chased payroll twice, still no bank details.'));",
              "pm.test('done was not touched', () => pm.expect(item.done).to.be.false);"
            ]
