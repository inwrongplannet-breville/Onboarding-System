              "pm.test('incomplete onboarding cancels', () =>",
              "  pm.expect(employee.archivedAs).to.eql('Onboarding Cancelled'));",
              "pm.test('the checklist is still there', () =>",
              "  pm.expect(employee.checklist).to.have.lengthOf(8));"
