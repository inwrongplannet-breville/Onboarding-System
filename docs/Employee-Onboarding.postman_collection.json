    {
      "name": "Duplicate employee ID - 409 (the guarantee the key change buys)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "const body = pm.response.json();",
              "pm.test('names the field so the form can paint it', () => {",
              "  pm.expect(body.error.code).to.eql('Conflict');",
              "  pm.expect(body.error.fields).to.have.property('employeeId');",
              "});",
              "// The point of the condition expression: PutItem overwrites by default, so",
              "// without it this call would have replaced a real person and their history.",
              "pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/employees/{{employeeId}}'), (err, res) => {",
              "  pm.test('the original employee is untouched', () => {",
              "    pm.expect(res.json().firstName).to.eql('Priya');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
